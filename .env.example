# Copy to .env and fill in values. Do not commit .env.
# Full setup: see README.md

PORT=3000
NODE_ENV=development

# Clerk — use the Development instance (pk_test_ / sk_test_) for local work.
# Same Clerk app as the mobile EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional locally. Only needed to test Clerk Dashboard → user.deleted cleanup.
# In-app delete account does NOT need this. See README.md → Webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase — Dashboard → Settings → API (use the service_role key, never the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
