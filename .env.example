PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Clerk — JWT verification + account deletion (required in production)
# MUST be the same Clerk application as the mobile app's EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Clerk webhooks — cleans backend when a user is deleted in Clerk Dashboard (user.deleted)
# In-app delete account uses DELETE /api/v1/me and does not require this webhook.
# Dashboard → Webhooks → URL: https://YOUR_HOST/webhooks/clerk → Events: user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase — server-side only (Dashboard → Settings → API → service_role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins for CORS (e.g. http://localhost:8081). Leave empty in dev to allow all.
CORS_ORIGINS=

# Rate limiting (optional — defaults shown)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_API_MAX_IP=120
# RATE_LIMIT_API_MAX_USER=100
# RATE_LIMIT_WRITE_MAX=60

# Supabase migrations — run in Supabase SQL Editor in this exact order:
# 001_initial_schema.sql
# → 002_domain_tables.sql
# → 003_storage_buckets.sql
# → 004_rls_policies.sql
# → 005_user_id_fk.sql
# → 006_rls_user_id.sql
# → 007_customer_id.sql
# → 008_sync_infrastructure.sql
# → 009_user_backups.sql
